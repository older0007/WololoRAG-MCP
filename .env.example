# ==============================================================================
# Environment Variables Template (.env.example) for WololoRAG-MCP
# Copy this file to ".env" and customize when connecting to `WololoRAG-Infra`.
#
# By default (with empty .env), WololoRAG-MCP reads the local databases created
# by the sibling `../WololoRAG/data/` Indexer directory.
# To connect to the Docker PostgreSQL + Qdrant stack from `WololoRAG-Infra`,
# uncomment DATABASE_URL, QDRANT_MODE, and QDRANT_URL below.
# ==============================================================================

# --- Option A: Connect to PostgreSQL + Qdrant from `WololoRAG-Infra` (Docker) ---
# DATABASE_URL=postgresql+psycopg://wololo:wololo_pass@localhost:5432/wololo_rag
# QDRANT_MODE=server
# QDRANT_URL=http://localhost:6333

# --- Option B: Local File Databases created by sibling Indexer repo ---
# SQLITE_PATH=../WololoRAG/data/wololo_state.db
# QDRANT_MODE=local
# QDRANT_LOCAL_PATH=../WololoRAG/data/qdrant

# --- Required ONLY when embedding.provider is set to "mistral" ---
MISTRAL_API_KEY=

# --- Required ONLY when mcp_server.auth.enabled is set to true ---
MCP_SECRET_TOKEN=dev-mcp-secret-token
